            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎮 FIRST ENCOUNTER</h1>
        <div class="subtitle">Classifica Punteggi VR</div>

        <div class="tabs">
            <div class="tab active" onclick="switchTab('today')">📅 Oggi</div>
            <div class="tab" onclick="switchTab('global')">🌍 Globale</div>
        </div>

        <div class="scoreboard">
            <div id="todaySection" class="scoreboard-section active">
                <div class="section-title">🏆 Classifica di Oggi</div>
                <div class="today-date">${formattedDate}</div>
                <div class="scoreboard-header">
                    <div>Pos.</div>
                    <div>Nome</div>
                    <div>Punteggio</div>
                </div>
                <div id="todayScoreList"></div>
            </div>

            <div id="globalSection" class="scoreboard-section">
                <div class="section-title">🌟 Classifica Globale</div>
                <div class="scoreboard-header">
                    <div>Pos.</div>
                    <div>Nome</div>
                    <div>Punteggio</div>
                </div>
                <div id="globalScoreList"></div>
            </div>
        </div>
    </div>

    <script>
        // Dati incorporati al momento della generazione
        const scores = ${JSON.stringify(scores, null, 8)};

        // Ottieni la data di oggi in formato YYYY-MM-DD
        function getTodayDate() {
            return '${today}';
        }

        // Filtra i punteggi di oggi
        function getTodayScores() {
            const today = getTodayDate();
            return scores.filter(score => score.date === today);
        }

        // Cambia tab
        function switchTab(tab) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');

            document.querySelectorAll('.scoreboard-section').forEach(s => s.classList.remove('active'));
            if (tab === 'today') {
                document.getElementById('todaySection').classList.add('active');
            } else {
                document.getElementById('globalSection').classList.add('active');
            }
        }

        // Renderizza una lista di punteggi
        function renderScoreList(scoreArray, listElementId, isGlobalList = false) {
            const scoreList = document.getElementById(listElementId);

            if (scoreArray.length === 0) {
                const message = isGlobalList
                    ? 'Nessun punteggio registrato.<br>🚀'
                    : 'Nessun punteggio registrato oggi.<br>🚀';
                scoreList.innerHTML = '<div class="empty-state">' + message + '</div>';
                return;
            }

            const sortedScores = [...scoreArray].sort((a, b) => b.score - a.score);

            scoreList.innerHTML = sortedScores.map((item, displayIndex) => {
                const posClass = displayIndex === 0 ? 'position-1' : displayIndex === 1 ? 'position-2' : displayIndex === 2 ? 'position-3' : '';
                const medal = displayIndex === 0 ? '🥇' : displayIndex === 1 ? '🥈' : displayIndex === 2 ? '🥉' : '';

                return '<div class="score-item">' +
                    '<div class="position ' + posClass + '">' + medal + ' ' + (displayIndex + 1) + '</div>' +
                    '<div>' + item.name + '</div>' +
                    '<div style="font-weight: bold; font-size: 1.2em;">' + item.score.toLocaleString() + '</div>' +
                    '</div>';
            }).join('');
        }

        // Renderizza tutte le liste dei punteggi
        function renderScores() {
            const todayScores = getTodayScores();
            renderScoreList(todayScores, 'todayScoreList', false);
            renderScoreList(scores, 'globalScoreList', true);
        }

        // Carica i punteggi all'avvio
        renderScores();
    </script>
</body>
</html>`;

            // Crea il blob e scarica il file
            const blob = new Blob([clientHTML], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = \`first-encounter-classifica-\${today}.html\`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            alert('✅ Pagina client generata e scaricata!\\nPuoi condividere questo file HTML con chiunque.');
        }

        // Gestione Enter per aggiungere punteggio
        document.getElementById('playerName').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('playerScore').focus();
            }
        });

        document.getElementById('playerScore').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                addOrUpdateScore();
            }
        });

        // Carica i punteggi all'avvio
        loadScores();
    </script>
</body>
</html>
