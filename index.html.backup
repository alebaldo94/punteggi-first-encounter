            .scoreboard-header,
            .score-item {
                grid-template-columns: 60px 1fr 120px;
                font-size: 0.9em;
            }
            .tabs {
                flex-direction: row;
                width: 100%;
            }
            .tab {
                flex: 1;
                padding: 10px 15px;
